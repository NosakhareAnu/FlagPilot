# FlagPilot configuration. Copy to .env or (recommended) run:  python scripts/setup.py
# Values marked GENERATED are replaced with random secrets by scripts/setup.py. Never commit .env.

# --- PostgreSQL (compose service "postgres") ---
POSTGRES_USER=flagpilot
POSTGRES_PASSWORD=GENERATED
POSTGRES_DB=flagpilot

# --- Demo administrator (dashboard login). Password is hashed with Argon2 at startup. ---
ADMIN_EMAIL=admin@flagpilot.local
ADMIN_PASSWORD=GENERATED

# --- Bootstrap evaluation API keys (one per environment; stored hashed in the DB) ---
# Used by the demo app (server side only). Create more keys in the dashboard.
BOOTSTRAP_API_KEY_DEVELOPMENT=GENERATED
BOOTSTRAP_API_KEY_PRODUCTION=GENERATED

# --- Behaviour ---
SEED_DEMO_DATA=true
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
SESSION_TTL_HOURS=12

# --- Cache ---
CACHE_TTL_SECONDS=30
NEGATIVE_CACHE_TTL_SECONDS=10

# --- Rate limits (requests per 60 s window) ---
EVAL_RATE_LIMIT=600
ADMIN_RATE_LIMIT=300
LOGIN_RATE_LIMIT=10
# Number of TRUSTED reverse proxies that append to X-Forwarded-For (nginx, a load balancer...). Keep 0 unless one
# really sits in front: the bundled Next.js proxy does NOT append the client address, so the header is spoofable.
TRUSTED_PROXY_HOPS=0

# --- Published host ports (bound to 127.0.0.1 only) ---
BACKEND_PORT=8000
FRONTEND_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379
